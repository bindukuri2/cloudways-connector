# --- Cloudways credentials (new access-token model) ---
# Generate an Access Token from https://platform.cloudways.com/api under the
# "Access Tokens" tab. Pick FULL ACCESS for POC, or LIMITED SCOPE with:
#   Server, Application, Git, Services, Operation
# Then paste the token here. It is used directly as a Bearer token — no email
# or API-key exchange is needed.
# See: https://support.cloudways.com/en/articles/5136065-how-to-create-and-manage-cloudways-api-access-tokens
CLOUDWAYS_ACCESS_TOKEN=

# --- Legacy credentials (deprecated) ---
# These stop working after Oct 15, 2026. Only set them if you have not yet
# generated an Access Token above. If both are set, CLOUDWAYS_ACCESS_TOKEN
# takes precedence.
# CLOUDWAYS_EMAIL=you@example.com
# CLOUDWAYS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: fallback server id ---
# The plugin normally resolves the server via its picker/create flow and passes
# serverId inside each DeployRequest. Set CLOUDWAYS_SERVER_ID here only if you
# want a hard fallback used when the plugin didn't provide one (useful for CI
# or single-server accounts). Leave commented out for normal use.
# CLOUDWAYS_SERVER_ID=1577767

# --- Server config ---
PORT=8787
HOST=127.0.0.1

# --- Optional ---
# Override the Cloudways API base URL if you're testing against a stub.
# CLOUDWAYS_API_BASE_URL=https://api.cloudways.com/api/v1
# Override the public app URL pattern Cloudways returns:
# CLOUDWAYS_APP_URL_PATTERN=https://{app_label}.cloudwaysapps.com
